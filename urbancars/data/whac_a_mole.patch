     def __init__(self, args):
         self.args = args
 
+    @staticmethod
+    def _rect_mask(height, width, bbox=None):
+        if bbox is not None:
+            x1, y1, x2, y2 = bbox
+            x1 = max(0, min(int(x1), width - 1))
+            y1 = max(0, min(int(y1), height - 1))
+            x2 = max(x1 + 1, min(int(x2), width - 1))
+            y2 = max(y1 + 1, min(int(y2), height - 1))
+        else:
+            x1 = int(round(0.10 * width))
+            x2 = int(round(0.90 * width))
+            y1 = int(round(0.20 * height))
+            y2 = int(round(0.82 * height))
+            x2 = max(x1 + 1, min(x2, width - 1))
+            y2 = max(y1 + 1, min(y2, height - 1))
+        mask = np.zeros((height, width), dtype=np.uint8)
+        mask[y1 : y2 + 1, x1 : x2 + 1] = 255
+        return mask, (x1, y1, x2 - x1, y2 - y1)
+
+    @classmethod
+    def _fallback_mask(cls, img_bgr, bbox=None):
+        height, width = img_bgr.shape[:2]
+        rect_mask, rect = cls._rect_mask(height, width, bbox=bbox)
+
+        # Try GrabCut first; if it fails or collapses, fall back to the rectangle mask.
+        try:
+            gc_mask = np.zeros((height, width), np.uint8)
+            bgd_model = np.zeros((1, 65), np.float64)
+            fgd_model = np.zeros((1, 65), np.float64)
+            cv2.grabCut(
+                img_bgr,
+                gc_mask,
+                rect,
+                bgd_model,
+                fgd_model,
+                3,
+                cv2.GC_INIT_WITH_RECT,
+            )
+            binary = np.where(
+                (gc_mask == cv2.GC_FGD) | (gc_mask == cv2.GC_PR_FGD),
+                255,
+                0,
+            ).astype(np.uint8)
+            fg_ratio = float(binary.mean()) / 255.0
+            if 0.01 <= fg_ratio <= 0.95:
+                return binary
+        except Exception:
+            pass
+
+        return rect_mask
+
     def __call__(self):
         cfg = get_cfg()
         add_deeplab_config(cfg)
